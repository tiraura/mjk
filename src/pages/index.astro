---
// src/pages/index.astro の該当部分
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="小説タイトル | 小説サイト">
  <div>
    {
      sortedPosts.map(async (post) => {
        const { Content } = await render(post);
        
        return (
          <!-- 各記事に固有のID（例: post-first-post）を自動付与 -->
          <article id={`post-${post.id}`} class="min-h-screen snap-start flex flex-col justify-center py-16">
            <h1 class="text-3xl md:text-5xl font-light tracking-tight text-white mb-4 leading-tight">
              {post.data.title}
            </h1>
            
            <time class="block text-sm text-neutral-500 mb-12 font-mono">
              {post.data.pubDate.toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
              })}
            </time>
            
            <div class="text-neutral-300 leading-[1.8] space-y-8 text-base md:text-lg">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>