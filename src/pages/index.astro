---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="ノベルタイトル">
  <div class="space-y-48">
    {
      sortedPosts.map(async (post) => {
        const { Content } = await render(post);
        const soundFile = post.data.sound ? `/${post.data.sound}` : '';
        
        return (
          <article 
            id={post.id} 
            data-sound={soundFile} 
            /* novel-page クラスを追加 */
            class="novel-page min-h-screen w-full flex flex-col justify-center items-center px-6 md:px-16 py-24"
          >
            <div class="max-w-[800px] w-full text-neutral-200 dark:text-neutral-300 leading-[2.2] space-y-8 text-base md:text-xl font-light tracking-wide">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>