---
// src/layouts/Layout.astro
import '../styles/global.css';
import RightMenu from '../components/RightMenu.astro';
import TopHeader from '../components/TopHeader.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" class="antialiased snap-y snap-mandatory scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />

    <!-- 💡 【超重要】画面が描画される前にlocalStorageを確認し、デフォルトでダークモードを適用するスクリプト -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      // 保存データがない初回アクセス時は、強制的に「dark」をデフォルトにする
      if (!savedTheme || savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen selection:bg-white/20 selection:text-white">
    <main class="max-w-[800px] mx-auto px-6 md:px-12">
      <slot />
    </main>

    <TopHeader />
    <RightMenu />
  </body>
</html>