---
// src/components/RightMenu.astro
---

<!-- 右端のコントロールパネル -->
<div class="fixed right-6 top-1/2 -translate-y-1/2 z-50 flex flex-col space-y-4 bg-white/5 dark:bg-black/20 border border-white/10 backdrop-blur-md rounded-full px-2 py-4 select-none">
  
  <!-- サウンドボタン -->
  <button 
    id="btn-sound" 
    type="button"
    class="w-10 h-10 rounded-full flex items-center justify-center text-lg text-white transition-all duration-300 hover:bg-white/10 cursor-pointer"
  >
    🔇
  </button>

  <!-- ブックマーク（栞）ボタン -->
  <button 
    id="btn-bookmark" 
    type="button"
    class="w-10 h-10 rounded-full flex items-center justify-center text-lg text-white transition-all duration-300 hover:bg-white/10 cursor-pointer"
  >
    🔖
  </button>

  <!-- テーマ切り替えボタン -->
  <button 
    id="btn-theme" 
    type="button"
    class="w-10 h-10 rounded-full flex items-center justify-center text-lg text-white transition-all duration-300 hover:bg-white/10 cursor-pointer"
  >
    🌙
  </button>
</div>

<!-- 音声ファイル -->
<audio id="bgm-audio" src="/ame.mp3" loop preload="auto"></audio>

<script>
  function setupControls() {
    console.log("コントローラーのセットアップを実行中..."); // 動作確認用のログ

    // 1. サウンド
    const btnSound = document.getElementById('btn-sound');
    const audio = document.getElementById('bgm-audio') as HTMLAudioElement;

    if (btnSound && audio) {
      btnSound.onclick = () => {
        console.log("サウンドボタンが押されました");
        if (audio.paused) {
          audio.play().then(() => {
            btnSound.textContent = '🔊';
          }).catch(err => console.log("再生失敗:", err));
        } else {
          audio.pause();
          btnSound.textContent = '🔇';
        }
      };
    }

    // 2. テーマ切り替え
    const btnTheme = document.getElementById('btn-theme');
    if (btnTheme) {
      btnTheme.onclick = () => {
        console.log("テーマボタンが押されました");
        const isDark = document.documentElement.classList.toggle('dark');
        btnTheme.textContent = isDark ? '🌙' : '☀️';
      };
    }
  }

  // ページ読み込み時に実行
  document.addEventListener('astro:page-load', setupControls);
  // 万が一のための通常ロード時実行
  if (document.readyState === 'complete') {
    setupControls();
  } else {
    window.addEventListener('load', setupControls);
  }
</script>