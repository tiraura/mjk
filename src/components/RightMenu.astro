---
// src/components/RightMenu.astro
---

<!-- 右側に浮かぶ縦型コントロールパネル -->
<div id="reading-controls" class="fixed right-6 top-1/2 -translate-y-1/2 z-50 flex flex-col space-y-4 bg-white/5 dark:bg-black/20 border border-white/10 backdrop-blur-md rounded-full px-2 py-4 select-none">
  
  <!-- 【1】サウンドボタン -->
  <button 
    id="btn-sound" 
    class="w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all duration-300 hover:bg-white/10 active:scale-95"
    title="BGM ON/OFF"
  >
    🔇
  </button>

  <!-- 【2】ブックマーク（栞）ボタン -->
  <button 
    id="btn-bookmark" 
    class="w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all duration-300 hover:bg-white/10 active:scale-95 group relative"
    title="ここに栞を挟む"
  >
    🔖
  </button>

  <!-- 【3】テーマ切り替えボタン -->
  <button 
    id="btn-theme" 
    class="w-10 h-10 rounded-full flex items-center justify-center text-lg transition-all duration-300 hover:bg-white/10 active:scale-95"
    title="ダーク/ライトモード切り替え"
  >
    🌙
  </button>
</div>

<!-- 音楽再生用の隠しaudio要素（public/ame.mp3 を指定） -->
<audio id="bgm-audio" src="/ame.mp3" loop preload="auto"></audio>

<!-- src/components/RightMenu.astro の <script> 部分をこれに差し替えます -->
<script>
  // 画面がロードされたときに実行する関数
  function initReadingControls() {
    // --- 1. ダーク/ライトモードの処理 ---
    const btnTheme = document.getElementById('btn-theme');
    if (btnTheme) {
      const savedTheme = localStorage.getItem('theme') || 'dark';
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
        btnTheme.textContent = '🌙';
      } else {
        document.documentElement.classList.remove('dark');
        btnTheme.textContent = '☀️';
      }

      // 既存のイベント重複を防ぐため、一度属性をクリアしてから登録
      btnTheme.onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        if (isDark) {
          localStorage.setItem('theme', 'dark');
          btnTheme.textContent = '🌙';
        } else {
          localStorage.setItem('theme', 'light');
          btnTheme.textContent = '☀️';
        }
      };
    }

    // --- 2. 栞（ブックマーク）の処理 ---
    const btnBookmark = document.getElementById('btn-bookmark');
    
    if (window.location.pathname === '/') {
      const savedBookmarkId = localStorage.getItem('novel_bookmark');
      if (savedBookmarkId) {
        setTimeout(() => {
          const targetArticle = document.getElementById(savedBookmarkId);
          if (targetArticle) {
            targetArticle.scrollIntoView({ behavior: 'smooth' });
          }
        }, 300);
      }
    }

    if (btnBookmark) {
      btnBookmark.onclick = () => {
        const articles = document.querySelectorAll('article');
        let closestArticle = null;
        let minDistance = Infinity;

        articles.forEach((article) => {
          const rect = article.getBoundingClientRect();
          const distance = Math.abs(rect.top);
          if (distance < minDistance) {
            minDistance = distance;
            closestArticle = article;
          }
        });

        if (closestArticle) {
          let articleId = closestArticle.id;
          if (!articleId) {
            articleId = 'article-' + Math.random().toString(36).substring(2, 9);
            closestArticle.id = articleId;
          }

          localStorage.setItem('novel_bookmark', articleId);
          btnBookmark.textContent = '📍';
          setTimeout(() => {
            btnBookmark.textContent = '🔖';
          }, 1000);
        }
      };
    }

    // --- 3. サウンド（MP3ファイル再生）の処理 ---
    const btnSound = document.getElementById('btn-sound') as HTMLButtonElement;
    const audio = document.getElementById('bgm-audio') as HTMLAudioElement;

    if (btnSound && audio) {
      // 保持されている状態を反映
      const savedSoundState = localStorage.getItem('novel_sound') === 'on';
      if (savedSoundState) {
        audio.play().then(() => {
          btnSound.textContent = '🔊';
        }).catch(() => {
          btnSound.textContent = '🔇';
          localStorage.setItem('novel_sound', 'off');
        });
      }

      btnSound.onclick = () => {
        if (audio.paused) {
          audio.play().then(() => {
            btnSound.textContent = '🔊';
            localStorage.setItem('novel_sound', 'on');
          }).catch((err) => {
            console.log("再生エラー:", err);
          });
        } else {
          audio.pause();
          btnSound.textContent = '🔇';
          localStorage.setItem('novel_sound', 'off');
        }
      };
    }
  }

  // Astroのページ遷移ライフサイクルに合わせて実行
  document.addEventListener('astro:page-load', initReadingControls);
</script>